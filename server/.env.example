# Copy this file to server/.env and fill in your local PostgreSQL details.
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/staywell
# Or use these individual values instead of DATABASE_URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=staywell
# DB_USER=postgres
# DB_PASSWORD=your_password
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@staywell.local
ADMIN_PASSWORD=change-this-before-seeding
